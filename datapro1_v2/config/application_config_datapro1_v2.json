{
  "schema_version": "1.0",
  "source": {
    "mode": "file",
    "file": {
      "path": "${AMANITA_RESOURCES_DIR}/datasets/raw/frames/SWIR_Camera/C001_F%06d.tiff",
      "recursive": false,
      "repeat": false
    }
  },
  "logging": {
    "enabled": true,
    "config_file": "config/datapro1_v2-log.xml",
    "default_level": "INFO",
    "realtime_profile": "rt_safe",
    "structured_messages": true,
    "sampling": {
      "frame_summary_every_n": 100
    }
  },
  "profiling": {
    "enabled": true,
    "mode": "lightweight",
    "levels": [
      "P0",
      "P1",
      "P2",
      "P4",
      "P5"
    ],
    "aggregation_window_frames": 300,
    "reports": {
      "emit_frame_reports": false,
      "emit_window_summary": true,
      "emit_run_summary": true
    },
    "logging_bridge": {
      "emit_aggregated_summaries": true,
      "summary_every_n_frames": 300,
      "emit_budget_warnings": false
    }
  },
  "visualization": {
    "enabled": true,
    "output_dir": "datapro1_v2_output/visualization",
    "mode": "sync_file",
    "every_n_frames": 1,
    "max_frames": 100,
    "stages": [
      "radiometric"
    ]
  },
  "dp2": {
    "enabled": false,
    "mode": "disabled",
    "host": "127.0.0.1",
    "port": 11511,
    "reconnect_interval_s": 3
  }
}
